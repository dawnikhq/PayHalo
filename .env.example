# ── Hack1 environment ────────────────────────────────────────────────────────
# Nothing here is required. Without any of these the app still runs:
#   • locally  → SQLite file at data/hack1.db
#   • on Vercel → in-memory (seeded per instance, resets on cold start)

# Force a storage driver: kv | sqlite | memory
# HACK1_STORE=kv

# Durable storage on Vercel: add Upstash Redis from the Vercel Marketplace and
# connect it to the project — it injects one of these pairs automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
