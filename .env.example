# ---------------------------------------------------------------- accounts
# VIVO has its own accounts (password + optional emailed link). Supabase is the
# database only — it is NOT the identity provider.
#
# Email is sent through Brevo (see the email block near the bottom). Without it
# the "email me a link" tab explains that delivery is off; passwords still work.

# Optional. Forces the account driver: supabase | sqlite. Local dev often uses
# sqlite matching HACK1_STORE=sqlite.
# VIVO_AUTH_STORE=sqlite

# ---------------------------------------------------------------- database
# NEXT_PUBLIC_* are exposed to the browser (safe: the anon key is public).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side storage + admin calls. Never expose this one to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Signs keyholder / beneficiary links (HMAC). Rotating it invalidates every
# link already sent. Falls back to SUPABASE_SERVICE_KEY, then a dev constant.
VIVO_SHARE_SECRET=

# ---------------------------------------------------------------- storage
# Optional. HACK1_STORE forces a driver: supabase | kv | sqlite | memory.
# HACK1_STORE=supabase

# ----------------------------------------------------------------- paypal
# "sandbox" (default) or "live".
PAYPAL_ENV=sandbox

# From https://developer.paypal.com/dashboard/applications — REST app credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional, so one deployment can hold both pairs and switch with PAYPAL_ENV
# alone. When PAYPAL_ENV=sandbox these win over the two above.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Must match the return URL registered on the PayPal app.
# On Vercel, set this to https://<your-domain>/api/paypal/callback
PAYPAL_REDIRECT_URI=

# Payouts move money from the app's own business account. Off unless set.
PAYPAL_PAYOUTS_ENABLED=false

# The release passcode. Required: without it the release button never appears
# and the payout endpoint fails closed. Pick a phrase you are willing to rotate.
PAYPAL_PAYOUT_PASSCODE=

# Live payouts need both PAYPAL_ENV=live and this flag. Leave off until the
# sandbox round-trip (connect → release → payout → ledger) has been verified.
PAYPAL_ALLOW_LIVE_PAYOUTS=false

# --------------------------------------------------------------- AI drafting
# Any one of these turns on the "describe your plan" reader. Each provider is
# called server-side only; the keys never reach the browser. With none set, a
# deterministic reader answers instead and the screen says which one ran.
OPENAI_API_KEY=
# Point this at any OpenAI-compatible gateway (OpenRouter, Groq, a local server).
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model override, per provider. Defaults: gpt-4o-mini / claude-3-5-haiku-latest / gemini-2.0-flash
AI_MODEL=

# ------------------------------------------------------------------- email
# Brevo transactional email. Used for the sign-in link and the vault key.
# From: the sender must be a verified sender or domain in Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=PayHalo

# ------------------------------------------------------------------ release desk
# The operator passcode for /admin. Without it the desk refuses to open.
ADMIN_PASSCODE=
