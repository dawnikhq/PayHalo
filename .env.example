# ── Hack1 environment ────────────────────────────────────────────────────────
# Nothing here is required. Without any of these the app still runs:
#   • locally  → SQLite file at data/hack1.db
#   • on Vercel → in-memory (seeded per instance, resets on cold start)

# Force a storage driver: supabase | kv | sqlite | memory
# HACK1_STORE=supabase

# Durable storage option A — Supabase Postgres (used by the live demo).
# The whole document lives in one jsonb row of public.hack1_state; RLS is on
# with no policies, so only the service key can reach it. Server-side only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=

# Durable storage option B — Upstash Redis from the Vercel Marketplace and
# connect it to the project — it injects one of these pairs automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
